# Local Configuration (without Terraform)
# Usage: cp .env.local.example .env && make start

# Ollama
OLLAMA_PORT=11434
OLLAMA_ORIGINS=*
OLLAMA_KEEP_ALIVE=-1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_LOAD_TIMEOUT=10m

# Model
MODEL_NAME=gpt-oss:120b
MODEL_PULL_ON_START=true

# API
API_TIMEOUT=600

# Logging
LOG_LEVEL=info

# Open WebUI
WEBUI_PORT=3000

# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WEBUI_SECRET_KEY=""

WEBUI_NAME="LLM Chat"
ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=pending
WEBUI_AUTH=true

# HTTPS (optional, leave empty for local)
DOMAIN_NAME=""
ACME_EMAIL=""

# CrowdSec
# Generate with: openssl rand -hex 32
CROWDSEC_BOUNCER_KEY=""
# From https://app.crowdsec.net
CROWDSEC_ENROLL_KEY=""
