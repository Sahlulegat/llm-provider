# Terraform Cloud Configuration
# Usage: cp .env.tf.example .env && set -a && source .env && set +a && cd deployment/terraform && ./deploy.sh apply

# UpCloud API Credentials
UPCLOUD_USERNAME=your-api-username
UPCLOUD_PASSWORD=your-api-password

# SSH Configuration (JSON format)
TF_VAR_ssh_public_keys='["ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI... user@example.com"]'

# Ollama
TF_VAR_ollama_port=11434
TF_VAR_ollama_origins="*"
TF_VAR_ollama_keep_alive="-1"
TF_VAR_ollama_max_loaded_models=1
TF_VAR_ollama_load_timeout="10m"

# Model
TF_VAR_model_name="gpt-oss:120b"
TF_VAR_model_pull_on_start=true

# API
TF_VAR_api_timeout=600
TF_VAR_log_level="info"

# Open WebUI
TF_VAR_webui_port=3000
TF_VAR_webui_name="LLM Chat"
TF_VAR_enable_signup=true
TF_VAR_default_user_role="pending"
TF_VAR_webui_auth=true

# HTTPS
TF_VAR_domain_name=""
TF_VAR_acme_email=""

# Security
# Generate with: openssl rand -hex 32
TF_VAR_caddy_api_key=""

# CrowdSec
# Generate with: openssl rand -hex 32
TF_VAR_crowdsec_bouncer_key=""
# From https://app.crowdsec.net
TF_VAR_crowdsec_enroll_key=""

# Gravitee (gateway IA)
# Sur le cloud il n'y a pas de Gravitee local : renseigner ici l'URL du
# Gravitee Enterprise hosté par l'entreprise. C'est la SEULE chose à changer
# pour migrer du Gravitee de test local vers le Gravitee payant.
# Ex : TF_VAR_llm_gateway_url="https://gw.entreprise.com/llm"
#      TF_VAR_llm_gateway_upstream="https://gw.entreprise.com"
TF_VAR_llm_gateway_url=""
TF_VAR_llm_gateway_upstream=""
TF_VAR_ocr_gateway_upstream=""
TF_VAR_llm_gateway_path="/llm"
TF_VAR_ocr_gateway_path="/ocr"

# Auto-Shutdown (seconds)
TF_VAR_inactivity_timeout=3600

# Network
TF_VAR_private_network_cidr="172.30.0.0/24"
TF_VAR_bastion_private_ip="172.30.0.10"
TF_VAR_llm_server_private_ip="172.30.0.20"
