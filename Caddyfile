{
    admin off
    auto_https off
    order crowdsec first
    crowdsec {
        api_url http://crowdsec:8080
        api_key {$CROWDSEC_BOUNCER_KEY}
    }
    servers {
        trusted_proxies static 172.30.0.0/24
    }
}

http://ui.{$DOMAIN_NAME:localhost} {
    log {
        output file /data/access.log
        format json
    }

    route {
        crowdsec
        @unauthorized not header X-API-Key "{$CADDY_API_KEY}"
        respond @unauthorized "Unauthorized" 401
        reverse_proxy open-webui:8080
    }

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
    }
}

http://api.{$DOMAIN_NAME:localhost} {
    log {
        output file /data/api-access.log
        format json
    }

    route {
        crowdsec
        @unauthorized not header X-API-Key "{$CADDY_API_KEY}"
        respond @unauthorized "Unauthorized" 401
        rewrite * {$LLM_GATEWAY_PATH:/llm}{uri}
        reverse_proxy {$LLM_GATEWAY_UPSTREAM:gravitee-gateway:8082} {
            transport http {
                dial_timeout 30s
                read_timeout 600s
                write_timeout 600s
            }
        }
    }

    header {
        -Server
        X-Content-Type-Options "nosniff"
    }
}

http://ocr.{$DOMAIN_NAME:localhost} {
    log {
        output file /data/ocr-access.log
        format json
    }

    route {
        crowdsec
        @unauthorized not header X-API-Key "{$CADDY_API_KEY}"
        respond @unauthorized "Unauthorized" 401
        rewrite * {$OCR_GATEWAY_PATH:/ocr}{uri}
        reverse_proxy {$LLM_GATEWAY_UPSTREAM:gravitee-gateway:8082} {
            transport http {
                dial_timeout 30s
                read_timeout 300s
                write_timeout 300s
            }
        }
    }

    header {
        -Server
        X-Content-Type-Options "nosniff"
    }
}
