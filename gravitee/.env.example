# Gravitee APIM — configuration locale
# Usage : cp .env.example .env (facultatif, toutes les valeurs ont un défaut)

# Version des images APIM (gateway, management-api, console, portal)
APIM_VERSION=4.12
MONGO_VERSION=7.0
ELASTIC_VERSION=8.16.1

# Ports exposés sur l'hôte
GRAVITEE_GATEWAY_PORT=8082
GRAVITEE_MGMT_API_PORT=8083
GRAVITEE_CONSOLE_PORT=8084
GRAVITEE_PORTAL_PORT=8085

# Réseau docker de la stack LLM (doit exister : make start dans la racine)
LLM_STACK_NETWORK=llm-provider-network

# --- Bootstrap des APIs (scripts/bootstrap-apis.sh) ---
# URL du Management API cible. Pour migrer vers le Gravitee hosté de l'entreprise :
# renseigner son URL + un Personal Access Token, rien d'autre à changer.
MGMT_API_URL=http://localhost:8083
# Auth basic (installation locale)
MGMT_API_USER=admin
MGMT_API_PASSWORD=admin
# OU Personal Access Token (prioritaire si renseigné — requis sur le Gravitee hosté)
MGMT_API_TOKEN=

# Backends vus depuis la gateway. En local : noms de conteneurs de la stack LLM.
# Sur le Gravitee hosté : URL publique de la stack (ex. https://api.sahlu.dev).
LLM_BACKEND_TARGET=http://ollama:11434
OCR_BACKEND_TARGET=http://paddleocr-vl-api:8080

# Context paths des APIs créées sur la gateway
LLM_API_PATH=/llm
OCR_API_PATH=/ocr
